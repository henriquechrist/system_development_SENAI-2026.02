programa {
  funcao inicio() {
    cadeia nome
    real n1,n2

    escreva("Digite seu nome:")
    leia(nome)
    escreva("Seu nome é ", nome,"\n")

    escreva("Digite sua primeira nota:")
    leia(n1)
    escreva("Sua nota é ", n1,"\n")

    escreva("Digite sua segunda nota:")
    leia(n2)
    escreva("Sua nota é ", n2,"\n")

  
    escreva("Seu nome é ", nome,"\n", "Sua média é:",(n1+n2)/2)



  }
}
