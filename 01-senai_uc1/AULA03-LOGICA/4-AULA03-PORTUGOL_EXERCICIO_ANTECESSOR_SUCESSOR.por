programa {
  funcao inicio() {
    //Variável que armazena número:
    inteiro numero

    //Print do número:
    escreva("Digite o nº: ")

    // Leiturea o número:
    leia(numero)

    //Operação do Programa
    escreva("antecessor: ", numero-1,"\n")
    escreva("sucessor: ", numero+1,"\n")
    
  }
}
