programa {
  funcao inicio() {
    cadeia matriz[2][2]
    para (inteiro l=0;l<2;l++){
      para(inteiro c=0;c<2;c++){
        escreva("Digite o nome:")
        leia(matriz[l][c])


      }
    }
      para (inteiro l=0;l<2;l++){
      para(inteiro c=0;c<2;c++){
        escreva(matriz[l][c]," ")
      }
      escreva("\n")
    
    }
}
}