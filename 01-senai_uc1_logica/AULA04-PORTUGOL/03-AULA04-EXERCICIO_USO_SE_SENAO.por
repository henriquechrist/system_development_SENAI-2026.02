programa {
  funcao inicio() {
    cadeia nome, senha
    escreva("Preencha o nome:")
    leia(nome)
    escreva("Preencha a senha:")
    leia(senha)
    se(nome=="João" e senha == "123456"){
      escreva("Bem vindo ao Sistema")
    }
    senao{
      escreva("Usuário não cadastrado!")
    }



  }
}




