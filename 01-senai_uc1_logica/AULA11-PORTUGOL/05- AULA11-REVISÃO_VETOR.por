programa
{
	
	funcao inicio()
	{
	cadeia nomes[5]

	para(inteiro i=0; i<5; i++){
		escreva("Nome:","\n")
		leia(nomes[i])

			
	}
	escreva("Primeiro Nome: ",nomes[0],"Ultimo Nome: ",nomes[4])
	
	



		
	}
}
