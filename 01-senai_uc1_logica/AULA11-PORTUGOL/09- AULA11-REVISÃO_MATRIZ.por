programa
{
	
	funcao inicio()
	{
		cadeia carros[3][3]={{"ABC123","FIESTA","SIM"},
						 {"CBA321","PARATI","NÃO"},
						 {"BAX231","SENTRA","SIM"}
						 }	
			
			para (inteiro linha=0;linha<3;linha++){
				para (inteiro coluna=0;coluna<3;coluna++){
				escreva(carros[linha][coluna],"\t")	
			}
	



	
	
	}
}
}
