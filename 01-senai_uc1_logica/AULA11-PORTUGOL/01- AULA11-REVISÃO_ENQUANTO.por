programa
{
	
	funcao inicio()
	{

	cadeia nome
	escreva ("Insira o nome:")
	leia(nome)
	enquanto( nome != ""){
			escreva("O nome digitado foi:",nome,"\n")
			escreva("Insira o Nome: ")
			leia(nome)
		
	}




		
	}
}
