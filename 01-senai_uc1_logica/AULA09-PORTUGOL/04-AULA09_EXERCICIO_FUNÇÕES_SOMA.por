programa
{
	//CRIAR UMA FUNÇÃO PARA RECEBER DOIS PARAMETROS E CALCULAR A SOMA
	funcao inicio()
	{
	inteiro num1, num2
	escreva("Primeiro Nº:","\n")
		leia(num1)

	escreva("Segundo Nº:","\n")
	leia(num2)

	soma(num1,num2)
	
	}

	funcao soma(inteiro n1,inteiro n2)
	{ 
	escreva("Soma:" ,"\n",n1+n2)
	}
}
