programa
{
	
	funcao inicio()
	{
	inteiro num1,resposta
	escreva("Digite o Nº:","\n")
		leia(num1)
		
	resposta= multi(num1)
	
	escreva("Resposta:","\n",resposta)
	

	}

	funcao inteiro multi(inteiro n1)
	{
		
	inteiro m
		m=n1*10
	
	retorne m
	
	}
}
