programa
{
	inclua biblioteca Util
	
	funcao inicio()
	{
		inteiro numero=0
		sorteio(numero)
	}

	funcao sorteio(inteiro numero){
		escreva("Número Sorteado: ", Util.sorteia (numero,100))
		

		
	}
}
