programa
{
	
	funcao inicio()
{
	escreva ("Olá Mundo","\n")
		mensagem (2027, "CAF","Empresa")
	}
	
	funcao mensagem(inteiro ano, cadeia nome,cadeia texto){
	escreva ("***",texto,"***","\n")
		escreva ("***-",nome,"-***","\n")
			escreva ("***-", ano,"-***","\n")
		
	}
}

